  "narrative": {
    "northStar": "Linear 风格的数据工作台",
    "overview": "DATA-AGENT 使用用户选定的浅灰、紧凑、细分隔线方向，作为本模块自有产品品牌。正文、表格、SQL 和执行状态构成视觉中心，紫靛色强调操作及当前选择。这里记录 `assets/app.css` 与 `assets/index.html` 已实现的局部系统，不覆盖 DB-GPT 仓库其他页面的视觉规范。\n\n底层框架仍为 DB-GPT；包名、命令、框架归属和版权保留。Linear 仅描述选定风格，不代表官方设计系统或关联产品。品牌使用 DATA-AGENT 文字及三条高度不同的线条组成的 SVG 数据标记。",
    "keyCharacteristics": [
      "浅灰导航、白色工作面与细分隔线。",
      "紧凑中文工具界面，表格与 SQL 优先。",
      "紫靛色集中表达操作、选中与焦点。",
      "平面层级与小圆角，不依赖阴影。"
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "选中和焦点使用工作紫靛；成功、错误与风险提示沿用各自语义，并保留文字说明。",
        "section": "colors"
      },
      {
        "name": "The Data Readability Rule",
        "body": "窄屏以横向滚动保留图表标签与数据可读性，不能用整体缩放把文字压小。",
        "section": "layout"
      },
      {
        "name": "The Flat Workbench Rule",
        "body": "延续平面工作区，用背景、分隔线和留白建立层级。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 延续浅灰侧栏、白色工作面、细分隔线与紧凑间距。",
      "**Do** 使用 DATA-AGENT 文字品牌和本模块 SVG 数据标记。",
      "**Do** 保留明确的焦点、状态文字、表格和图表滚动与 SQL 换行。",
      "**Do** 将此规范限定在 safe_analysis_web，准确表达自有产品身份与 DB-GPT 框架归属。"
    ],
    "donts": [
      "**Don't** 把旧 DB-GPT 中文 logo 作为本模块产品标识恢复。",
      "**Don't** 将风险色用于普通主操作或当前导航。",
      "**Don't** 把本模块局部规则推广成整个仓库的规范。"
    ]
  }
}
